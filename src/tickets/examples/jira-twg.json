{
  "name": "Jira (twg)",
  "listCmd": "twg jira workitem query --site YOUR-SITE.atlassian.net --jql \"assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC\" --fields summary,status,description --limit 100 -o json --output-summary none",
  "scope": "workspace",
  "itemsPath": "data.issues",
  "setStatusCmd": "twg jira workitem update --site YOUR-SITE.atlassian.net --id ${id} --status \"${status}\"",
  "statusMap": {
    "todo": "To Do",
    "doing": "In Progress",
    "review": "In Review",
    "done": "Done"
  },
  "logTimeCmd": "curl -sS --fail -u \"$JIRA_EMAIL:$JIRA_API_TOKEN\" -H \"Content-Type: application/json\" -X POST \"https://YOUR-SITE.atlassian.net/rest/api/3/issue/${id}/worklog\" -d \"{\\\"timeSpentSeconds\\\":${seconds},\\\"started\\\":\\\"${startedAt}\\\"}\"",
  "map": {
    "id": "key",
    "title": "summary",
    "status": "status.name",
    "url": "url",
    "description": "description"
  }
}
