{
  "name": "agent-workbench",
  "displayName": "Agent Workbench",
  "description": "Control room for parallel, ticket-driven agentic coding sessions in git worktrees.",
  "version": "0.0.1",
  "private": true,
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentWorkbench",
          "title": "Agent Workbench",
          "icon": "media/workbench.svg"
        }
      ]
    },
    "views": {
      "agentWorkbench": [
        {
          "id": "agentWorkbench.work",
          "name": "Work"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agentWorkbench.work",
        "contents": "No ticket sources configured.\nA source is a command that prints JSON, such as `gh issue list --json number,title,state,url`.\n[Configure ticket sources](command:workbench.action.openSettingsJson)\n[New Ad-hoc Session](command:agentWorkbench.newAdhocSession)"
      }
    ],
    "commands": [
      {
        "command": "agentWorkbench.refreshTickets",
        "title": "Refresh Tickets",
        "category": "Agent Workbench",
        "icon": "$(refresh)"
      },
      {
        "command": "agentWorkbench.openTicketInBrowser",
        "title": "Open in Browser",
        "category": "Agent Workbench",
        "icon": "$(link-external)"
      },
      {
        "command": "agentWorkbench.newSessionForTicket",
        "title": "Work on This in New Session",
        "category": "Agent Workbench",
        "icon": "$(add)"
      },
      {
        "command": "agentWorkbench.newAdhocSession",
        "title": "New Ad-hoc Session",
        "category": "Agent Workbench",
        "icon": "$(beaker)"
      },
      {
        "command": "agentWorkbench.openSessionShell",
        "title": "Open Shell in Session",
        "category": "Agent Workbench",
        "icon": "$(terminal)"
      },
      {
        "command": "agentWorkbench.openSessionTask",
        "title": "Open Task",
        "category": "Agent Workbench"
      },
      {
        "command": "agentWorkbench.openAgent",
        "title": "Open Agent",
        "category": "Agent Workbench",
        "icon": "$(robot)"
      },
      {
        "command": "agentWorkbench.startAgent",
        "title": "Start New Agent Conversation…",
        "category": "Agent Workbench"
      },
      {
        "command": "agentWorkbench.resumeAgent",
        "title": "Resume Agent",
        "category": "Agent Workbench"
      },
      {
        "command": "agentWorkbench.timeReport",
        "title": "Time Report…",
        "category": "Agent Workbench",
        "icon": "$(clock)"
      },
      {
        "command": "agentWorkbench.adjustTime",
        "title": "Adjust Time…",
        "category": "Agent Workbench"
      },
      {
        "command": "agentWorkbench.deleteSession",
        "title": "Delete Session",
        "category": "Agent Workbench",
        "icon": "$(trash)"
      },
      {
        "command": "agentWorkbench.openChange",
        "title": "Open Changes",
        "category": "Agent Workbench"
      },
      {
        "command": "agentWorkbench.openTicketHub",
        "title": "Open Ticket",
        "category": "Agent Workbench",
        "icon": "$(preview)"
      },
      {
        "command": "agentWorkbench.filterTickets",
        "title": "Filter Tickets…",
        "category": "Agent Workbench",
        "icon": "$(filter)"
      },
      {
        "command": "agentWorkbench.clearTicketFilter",
        "title": "Clear Ticket Filter",
        "category": "Agent Workbench",
        "icon": "$(filter-filled)"
      },
      {
        "command": "agentWorkbench.createPullRequest",
        "title": "Create Pull Request…",
        "category": "Agent Workbench",
        "icon": "$(git-pull-request-create)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "agentWorkbench.openAgent",
          "when": "agentWorkbench.inSession",
          "group": "navigation@90"
        },
        {
          "command": "agentWorkbench.openSessionShell",
          "when": "agentWorkbench.inSession",
          "group": "navigation@91"
        },
        {
          "command": "agentWorkbench.createPullRequest",
          "when": "agentWorkbench.inSession",
          "group": "navigation@92"
        }
      ],
      "view/title": [
        {
          "command": "agentWorkbench.newAdhocSession",
          "when": "view == agentWorkbench.work",
          "group": "navigation@1"
        },
        {
          "command": "agentWorkbench.refreshTickets",
          "when": "view == agentWorkbench.work",
          "group": "navigation@2"
        },
        {
          "command": "agentWorkbench.timeReport",
          "when": "view == agentWorkbench.work",
          "group": "navigation@3"
        },
        {
          "command": "agentWorkbench.filterTickets",
          "when": "view == agentWorkbench.work && !agentWorkbench.filtered",
          "group": "navigation@0"
        },
        {
          "command": "agentWorkbench.clearTicketFilter",
          "when": "view == agentWorkbench.work && agentWorkbench.filtered",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "agentWorkbench.newSessionForTicket",
          "when": "view == agentWorkbench.work && viewItem =~ /^ticket(WithUrl)?$/",
          "group": "inline@1"
        },
        {
          "command": "agentWorkbench.openTicketInBrowser",
          "when": "view == agentWorkbench.work && viewItem =~ /^ticket.*WithUrl$/",
          "group": "inline@2"
        },
        {
          "command": "agentWorkbench.openTicketHub",
          "when": "view == agentWorkbench.work && viewItem =~ /^ticket/",
          "group": "1_open"
        },
        {
          "command": "agentWorkbench.newAdhocSession",
          "when": "view == agentWorkbench.work && viewItem == other",
          "group": "inline"
        },
        {
          "command": "agentWorkbench.openAgent",
          "when": "view == agentWorkbench.work && viewItem == session",
          "group": "inline@0"
        },
        {
          "command": "agentWorkbench.openSessionShell",
          "when": "view == agentWorkbench.work && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "agentWorkbench.openAgent",
          "when": "view == agentWorkbench.work && viewItem == session",
          "group": "0_agent@1"
        },
        {
          "command": "agentWorkbench.resumeAgent",
          "when": "view == agentWorkbench.work && viewItem == session",
          "group": "0_agent@2"
        },
        {
          "command": "agentWorkbench.startAgent",
          "when": "view == agentWorkbench.work && viewItem == session",
          "group": "0_agent@3"
        },
        {
          "command": "agentWorkbench.openSessionTask",
          "when": "view == agentWorkbench.work && viewItem == session",
          "group": "1_open"
        },
        {
          "command": "agentWorkbench.createPullRequest",
          "when": "view == agentWorkbench.work && viewItem == session",
          "group": "2_share"
        },
        {
          "command": "agentWorkbench.adjustTime",
          "when": "view == agentWorkbench.work && viewItem == session",
          "group": "5_time"
        },
        {
          "command": "agentWorkbench.deleteSession",
          "when": "view == agentWorkbench.work && viewItem == session",
          "group": "9_delete"
        }
      ],
      "commandPalette": [
        {
          "command": "agentWorkbench.openTicketInBrowser",
          "when": "false"
        },
        {
          "command": "agentWorkbench.newSessionForTicket",
          "when": "false"
        },
        {
          "command": "agentWorkbench.openSessionShell",
          "when": "agentWorkbench.inSession"
        },
        {
          "command": "agentWorkbench.createPullRequest",
          "when": "agentWorkbench.inSession"
        },
        {
          "command": "agentWorkbench.openChange",
          "when": "false"
        },
        {
          "command": "agentWorkbench.openTicketHub",
          "when": "false"
        },
        {
          "command": "agentWorkbench.openSessionTask",
          "when": "false"
        },
        {
          "command": "agentWorkbench.deleteSession",
          "when": "false"
        },
        {
          "command": "agentWorkbench.openAgent",
          "when": "agentWorkbench.inSession"
        },
        {
          "command": "agentWorkbench.startAgent",
          "when": "false"
        },
        {
          "command": "agentWorkbench.resumeAgent",
          "when": "false"
        },
        {
          "command": "agentWorkbench.adjustTime",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Agent Workbench",
      "properties": {
        "agentWorkbench.agents": {
          "type": "array",
          "default": [],
          "markdownDescription": "Extra or overriding agent profiles. Built in: `claude` (Claude Code) and `codex`. A profile with the same `id` replaces the built-in one. Commands run in the session's worktree; placeholders: `${promptFile}` (relative path to `.workbench/TASK.md`), `${sessionId}`, `${branch}`.",
          "items": {
            "type": "object",
            "required": ["id", "label", "startCmd"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "startCmd": { "type": "string", "description": "Starts a new agent conversation, e.g. `aider --message-file ${promptFile}`." },
              "resumeCmd": { "type": "string", "description": "Continues the latest conversation in this worktree, e.g. `claude --continue`." }
            }
          }
        },
        "agentWorkbench.defaultAgent": {
          "type": "string",
          "default": "claude",
          "description": "Agent profile id used when a session starts its agent automatically or via Open Agent."
        },
        "agentWorkbench.startAgentOnCreate": {
          "type": "boolean",
          "default": true,
          "description": "Start the default agent as soon as a new session is created."
        },
        "agentWorkbench.notifyOnNeedsInput": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a session's agent starts waiting for your input."
        },
        "agentWorkbench.time.idleMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "A gap without your activity longer than this ends your time interval at your last activity."
        },
        "agentWorkbench.time.bookedFigure": {
          "type": "string",
          "enum": ["elapsed", "your", "agent"],
          "default": "elapsed",
          "enumDescriptions": [
            "Time you or an agent worked on the ticket (overlaps counted once).",
            "Only time you were active in the ticket's sessions, plus adjustments.",
            "Only time an agent was working on the ticket."
          ],
          "description": "Which figure is shown on tickets and booked in time reports."
        },
        "agentWorkbench.time.roundToMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "description": "Time reports round the booked figure up to blocks of this many minutes (0 = no rounding). Stored data is never rounded."
        },
        "agentWorkbench.ticketSources": {
          "type": "array",
          "default": [],
          "markdownDescription": "Ticket sources. Each is a shell command that prints JSON (run in the workspace folder) plus a map from ticket fields to dotted paths in each item. Example: `{ \"name\": \"GitHub\", \"listCmd\": \"gh issue list --json number,title,state,url\", \"map\": { \"id\": \"number\", \"title\": \"title\", \"status\": \"state\", \"url\": \"url\" } }`",
          "items": {
            "type": "object",
            "required": ["name", "listCmd", "map"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "description": "Unique display name." },
              "listCmd": { "type": "string", "description": "Shell command that prints the tickets as JSON." },
              "itemsPath": { "type": "string", "description": "Dotted path to the array of tickets when the command prints an object (e.g. \"issues\")." },
              "logCmd": {
                "type": "string",
                "markdownDescription": "Optional shell command that logs one worklog entry, used by **Log to tracker…** in the time report after you confirm. It receives the values as environment variables, never pasted into the command: `WB_TICKET_ID`, `WB_TICKET_SOURCE`, `WB_TICKET`, `WB_DATE` (YYYY-MM-DD), `WB_MINUTES`, `WB_SECONDS`, `WB_NOTE`. Must exit non-zero on failure."
              },
              "map": {
                "type": "object",
                "required": ["id", "title"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "status": { "type": "string" },
                  "url": { "type": "string" },
                  "description": { "type": "string", "description": "Dotted path to the ticket's body text, shown in the ticket hub." }
                }
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "mocha",
    "test:vscode": "npm run build && vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.93.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "mocha": "12.0.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
